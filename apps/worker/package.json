{
  "name": "@voiceforge/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@voiceforge/database": "workspace:*",
    "@voiceforge/notifications": "workspace:*",
    "@voiceforge/observability": "workspace:*",
    "@voiceforge/transcription": "workspace:*",
    "@aws-sdk/client-sesv2": "^3.940.0",
    "bullmq": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
