                "properties": {
                  "email": {
                    "format": "email",
                    "maxLength": 320,
                    "type": "string"
                  },
                  "role": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "owner"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "admin"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "supervisor"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "worker"
                        ]
                      },
                      {
