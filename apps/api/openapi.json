                            "supervisor"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "worker"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "auditor"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspaceId}/invitations": {
      "post": {
        "operationId": "createInvitation",
        "tags": [
          "memberships"
