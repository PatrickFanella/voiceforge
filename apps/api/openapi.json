    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "operations"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service",
                    "version",
                    "timestamp"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "enum": [
                        "voiceforge-api"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "timestamp": {
                      "format": "date-time",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/bootstrap": {
      "post": {
        "operationId": "bootstrapIdentity",
        "tags": [
          "identity"
        ],
        "parameters": [
          {
            "schema": {
              "minLength": 16,
              "maxLength": 255,
              "type": "string"
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user",
                    "personalWorkspaceId",
                    "workspaces"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "required": [
                        "id",
                        "displayName",
                        "primaryEmail"
                      ],
                      "properties": {
                        "id": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "displayName": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "primaryEmail": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    "personalWorkspaceId": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "workspaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "kind",
                          "name",
                          "timeZone",
                          "role"
                        ],
                        "properties": {
                          "id": {
                            "format": "uuid",
                            "type": "string"
                          },
                          "kind": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "personal"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "team"
                                ]
                              }
                            ]
                          },
                          "name": {
                            "type": "string"
                          },
                          "timeZone": {
                            "type": "string"
                          },
                          "role": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "owner"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "admin"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "supervisor"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "worker"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "auditor"
                                ]
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
