# Optional HTTPS endpoint accepting multipart field `audio` and returning:
# { "transcript": "...", "confidence": 0.0-1.0, "provider": "..." }
# Never place provider API keys in EXPO_PUBLIC_ variables or the mobile app.
EXPO_PUBLIC_TRANSCRIPTION_API_URL=

# Server-only local development values. Never expose these through EXPO_PUBLIC_*.
DATABASE_URL=postgresql://voiceforge:voiceforge@localhost:5432/voiceforge
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=voiceforge
S3_SECRET_ACCESS_KEY=voiceforge-local-only
S3_AUDIO_BUCKET=voiceforge-audio
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=voiceforge
AWS_SECRET_ACCESS_KEY=voiceforge-local-only
DEEPGRAM_API_KEY=
TRANSCRIPTION_CONCURRENCY=4
SAFETY_NOTIFICATION_CONCURRENCY=8
SES_FROM_EMAIL=alerts@voiceforge.example
EXPO_ACCESS_TOKEN=
SMTP_HOST=localhost
SMTP_PORT=1025
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.voiceforge.example
SYNC_CURSOR_SECRET=replace-with-at-least-32-random-bytes

# Supervisor console Auth0 web application (server-only except API URL).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=replace-with-32-byte-session-secret
APP_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Expo Auth0 native application. These identify public OAuth clients and contain no secret.
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.voiceforge.example
EXPO_PUBLIC_API_URL=http://localhost:3000

# Stripe team billing (server-only).
STRIPE_SECRET_KEY=
STRIPE_TEAM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
