# Optional HTTPS endpoint accepting multipart field `audio` and returning:
# { "transcript": "...", "confidence": 0.0-1.0, "provider": "..." }
# Never place provider API keys in EXPO_PUBLIC_ variables or the mobile app.
EXPO_PUBLIC_TRANSCRIPTION_API_URL=

# Server-only local development values. Never expose these through EXPO_PUBLIC_*.
DATABASE_URL=postgresql://voiceforge:voiceforge@localhost:5432/voiceforge
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=voiceforge
S3_SECRET_ACCESS_KEY=voiceforge-local-only
S3_AUDIO_BUCKET=voiceforge-audio
SMTP_HOST=localhost
SMTP_PORT=1025
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.voiceforge.example
SYNC_CURSOR_SECRET=replace-with-at-least-32-random-bytes
